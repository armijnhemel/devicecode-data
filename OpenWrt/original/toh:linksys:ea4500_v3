<code>
0: 0x000000000000-0x000000100000 : "uboot"
1: 0x000000100000-0x000000140000 : "u_env"
2: 0x000000140000-0x000000180000 : "caldata"
3: 0x000000180000-0x0000001c0000 : "s_env"
4: 0x0000001c0000-0x0000002c0000 : "devinfo"
