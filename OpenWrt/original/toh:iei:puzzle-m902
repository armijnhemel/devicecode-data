root@OpenWrt:/mnt# mkdir bkp
root@OpenWrt:/mnt# mv upper/ bkp/
root@OpenWrt:/mnt# mv work/ bkp/
root@OpenWrt:/mnt# mv .fs_state bkp/
</code>
5.3. Reboot\\ 


