	/firmware/openwrt/package/kernel/mac80211/files/lib/wifi/mac80211.sh
	
	option disabled 0

-> enable switch0\\
-> enable VLan\\
-> set Lan to WR710_WanPort and set Wan to WR710_LanPort -> do this if u need VLan capability @Wan(eth1.1)

	/firmware/openwrt/target/linux/ar71xx/base-files/etc/uci-defaults/02_network
	
	tl-wr710n)
	ucidef_add_switch "switch0" "1" "1"
	ucidef_add_switch_vlan "switch0" "1" "0t 3"
	ucidef_set_interfaces_lan_wan "eth0" "eth1.1"
	;;

