+	{
+		.bus_num	= 0,
+		.chip_select	= 0,
+		.mode		= 0,
+		.max_speed_hz	= 20000000,
+		.modalias	= "spidev",
+	},
	{
		.modalias = "b53-switch",
		.max_speed_hz = 781000,
		.bus_num = 0,
		.chip_select = 1,
		.platform_data = &DGND3700v1_3800B_b53_pdata,
	},
};

