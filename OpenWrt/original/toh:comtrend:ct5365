==== Example Network-VLAN Configuration (Movistar FTTH) ====
Path: **/etc/config/network**
<code>
config 'switch' 'eth0'
option 'enable' '1'
option 'enable_vlan' '1'
option 'reset' '1'

config 'switch_vlan' 'vlan2'
option 'vlan' '2'
option 'device' 'eth0'
option 'ports' '1 2 3 5'

config 'switch_vlan' 'vlan6'
option 'vlan' '6'
option 'device' 'eth0'
option 'ports' '0t 5'

config 'interface' 'loopback'
option 'ifname' 'lo'
option 'proto' 'static'
option 'ipaddr' '127.0.0.1'
option 'netmask' '255.0.0.0'

config 'interface' 'lan'
option 'type' 'bridge'
option 'ifname' 'eth0.2'
option 'proto' 'static'
option 'ipaddr' '192.168.1.1'
option 'netmask' '255.255.255.0'
option 'gateway' '192.168.1.1'
option 'dns' '8.8.8.8'
option 'nat' '1'
option 'defaultroute' '0'
option 'peerdns' '0'

config 'interface' 'wan'
option 'ifname' 'eth0.6'
option 'proto' 'pppoe'
option 'username' 'adslppp@telefonicanetpa'
option 'password' 'adslppp'
</code>

