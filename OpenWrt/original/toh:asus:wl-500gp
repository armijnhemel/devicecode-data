        option hwmode   11g
        option disabled 0
        option channel  9
        option txpower  13
        option country  DE

config wifi-iface
        option device           'radio0'
        option mode             'sta'
        option ssid             'wifi ssid'
        option network          wlan_br
        option encryption       'psk2'
        option key              'wifi pwd'
        
#/etc/config/network
....
#### LAN configuration
